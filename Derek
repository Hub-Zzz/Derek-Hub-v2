--==================== componentes ====================
local function slider(parent,label,min,max,def,cb)
  local row = mk("Frame",{Size=UDim2.new(1,0,0,52),BackgroundTransparency=1})
  row.Parent = parent
  mk("TextLabel",{Size=UDim2.new(1,-48,0,18),BackgroundTransparency=1,Font=Enum.Font.GothamMedium,Text=label,TextSize=14,TextColor3=TXT,TextXAlignment=Enum.TextXAlignment.Left}).Parent = row
  local val = mk("TextLabel",{Size=UDim2.new(0,38,0,22),Position=UDim2.new(1,-40,0.5,-11),BackgroundColor3=RED,Font=Enum.Font.GothamBold,Text=tostring(def),TextSize=12,TextColor3=Color3.new(1,1,1),BorderSizePixel=0})
  val.Parent = row
  mk("UICorner",{CornerRadius=UDim.new(1,0)}).Parent = val
  local track_ = mk("Frame",{Size=UDim2.new(1,-48,0,6),Position=UDim2.new(0,0,0,32),BackgroundColor3=BG3,BorderSizePixel=0})
  track_.Parent = row
  mk("UICorner",{CornerRadius=UDim.new(1,0)}).Parent = track_
  local fill = mk("Frame",{Size=UDim2.new(0,0,1,0),BackgroundColor3=RED,BorderSizePixel=0})
  fill.Parent = track_
  mk("UICorner",{CornerRadius=UDim.new(1,0)}).Parent = fill
  local knob = mk("Frame",{Size=UDim2.new(0,14,0,14),Position=UDim2.new(0,0,0.5,-7),BackgroundColor3=Color3.new(1,1,1),BorderSizePixel=0,ZIndex=2})
  knob.Parent = track_
  mk("UICorner",{CornerRadius=UDim.new(1,0)}).Parent = knob

  local held = false
  local function setA(a)
    a = math.clamp(a,0,1)
    fill.Size = UDim2.new(a,0,1,0)
    knob.Position = UDim2.new(a,-7,0.5,-7)
    local v = math.floor(min+(max-min)*a+0.5)
    val.Text = tostring(v)
    cb(v)
  end
  local function fromX(x)
    if track_.AbsoluteSize.X > 0 then
      setA((x-track_.AbsolutePosition.X)/track_.AbsoluteSize.X)
    end
  end
  track(track_.InputBegan:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then
      held = true fromX(i.Position.X)
    end
  end))
  track(track_.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then held = false end
  end))
  track(UIS.InputEnded:Connect(function(i)
    if i.UserInputType==Enum.UserInputType.MouseButton1 or i.UserInputType==Enum.UserInputType.Touch then held = false end
  end))
  track(UIS.InputChanged:Connect(function(i)
    if held and (i.UserInputType==Enum.UserInputType.MouseMovement or i.UserInputType==Enum.UserInputType.Touch) then
      fromX(i.Position.X)
    end
  end))
  setA((def-min)/(max-min))
end

local function toggle(parent,label,def,cb)
  local row = mk("Frame",{Size=UDim2.new(1,0,0,32),BackgroundTransparency=1})
  row.Parent = parent
  mk("TextLabel",{Size=UDim2.new(1,-60,1,0),BackgroundTransparency=1,Font=Enum.Font.GothamMedium,Text=label,TextSize=14,TextColor3=TXT,TextXAlignment=Enum.TextXAlignment.Left}).Parent = row
  local b = mk("TextButton",{Size=UDim2.new(0,42,0,22),Position=UDim2.new(1,-42,0.5,-11),BackgroundColor3=BG3,BorderSizePixel=0,Text="",AutoButtonColor=false})
  b.Parent = row
  mk("UICorner",{CornerRadius=UDim.new(1,0)}).Parent = b
  local k = mk("Frame",{Size=UDim2.new(0,16,0,16),Position=UDim2.new(0,3,0.5,-8),BackgroundColor3=DIM,BorderSizePixel=0})
  k.Parent = b
  mk("UICorner",{CornerRadius=UDim.new(1,0)}).Parent = k
  local on = def
  local function draw()
    if on then
      b.BackgroundColor3 = RED
      k.Position = UDim2.new(1,-19,0.5,-8)
      k.BackgroundColor3 = Color3.new(1,1,1)
    else
      b.BackgroundColor3 = BG3
      k.Position = UDim2.new(0,3,0.5,-8)
      k.BackgroundColor3 = DIM
    end
  end
  track(b.MouseButton1Click:Connect(function()
    on = not on
    draw()
    cb(on)
  end))
  draw()
end

local function button(parent,label,cb)
  local b = mk("TextButton",{Size=UDim2.new(1,0,0,34),BackgroundColor3=BG2,BorderSizePixel=0,Font=Enum.Font.GothamMedium,Text=label,TextSize=13,TextColor3=TXT,AutoButtonColor=false})
  b.Parent = parent
  mk("UICorner",{CornerRadius=UDim.new(0,8)}).Parent = b
  track(b.MouseButton1Click:Connect(cb))
  return b
end

--==================== lógica ====================
local function hum() local c=LP.Character return c and c:FindFirstChildOfClass("Humanoid") end
local function hrp() local c=LP.Character return c and c:FindFirstChild("HumanoidRootPart") end

local speed, jump = 16, 50
local infJump, noclip, fly = false, false, false
local bv = nil
local savedLight = nil

local function applyStats()
  local h = hum()
  if h then
    h.UseJumpPower = true
    h.WalkSpeed = speed
    h.JumpPower = jump
  end
end

local function setNoclip(state)
  local c = LP.Character
  if not c then return end
  for _,v in ipairs(c:GetDescendants()) do
    if v:IsA("BasePart") then v.CanCollide = not state end
  end
end

local function startFly()
  local r = hrp()
  if not r then return end
  if bv then bv:Destroy() end
  pcall(function() r:SetNetworkOwner(LP) end)
  bv = Instance.new("BodyVelocity")
  bv.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
  bv.Velocity = Vector3.zero
  bv.Parent = r
end

local function stopFly()
  if bv then bv:Destroy() bv = nil end
end

