local firstTab, firstPage
local function selectTab(b,pg)
  for _,s in ipairs(side:GetChildren()) do
    if s:IsA("TextButton") then s.BackgroundColor3 = BG2 end
  end
  for _,q in ipairs(pages:GetChildren()) do
    if q:IsA("Frame") then q.Visible = false end
