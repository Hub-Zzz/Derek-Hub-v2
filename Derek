-- mk tolerante: una propiedad mal escrita ya no rompe el script
local function mk(c,p)
  local o = Instance.new(c)
  if p then
    for k,v in pairs(p) do
      local ok = pcall(function() o[k] = v end)
      if not ok then warn("[DerekHub] propiedad invalida: "..tostring(k).." en "..c) end
    end
  end
  return o
end

