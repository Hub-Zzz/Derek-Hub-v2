local ROLE_KEYS = {
  {key="knife",    color=RED},
  {key="revolver", color=BLUE},
  {key="gun",      color=BLUE},
}

local esp = false
local hs = {}
local espAcc = 0

local function roleColor(p)
  local c = p.Character
  if c then
    for _,t in ipairs(c:GetChildren()) do
      if t:IsA("Tool") then
        local n = t.Name:lower()
        for _,r in ipairs(ROLE_KEYS) do
          if n:find(r.key, 1, true) then return r.color end
        end
      end
    end
  end
  return GREEN
end

local function clearESP()
  for _,h in pairs(hs) do pcall(function() h:Destroy() end) end
  table.clear(hs)
end

local function refreshESP()
  for _,p in ipairs(Players:GetPlayers()) do
    if p ~= LP then
      local char = p.Character
      if char and char:FindFirstChildOfClass("Humanoid") then
        local h = hs[p]
        if not h or h.Parent ~= char then
          if h then h:Destroy() end
          h = Instance.new("Highlight")
          h.FillTransparency = 0.65
          h.OutlineTransparency = 0.15
          h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
          h.Parent = char
          hs[p] = h
        end
        local c = roleColor(p)
        h.FillColor = c
        h.OutlineColor = c
      end
    end
  end
end

toggle(pVis,"ESP / Ver roles",false,function(s)
  esp = s
  if s then refreshESP() else clearESP() end
end)

track(RS.Heartbeat:Connect(function(dt)
  if not esp then return end
  espAcc += dt
  if espAcc < 0.25 then return end
  espAcc = 0
  refreshESP()
end))
track(Players.PlayerRemoving:Connect(function(p)
  local h = hs[p]
  if h then h:Destroy() hs[p] = nil end
end))

-- Auto
local _, pAuto = tab("Auto")
local autoCoin = false
local coinCache, coinRefresh = {}, 0

local function collectCoins()
  local list = {}
  for _,v in ipairs(workspace:GetDescendants()) do
    if v:IsA("BasePart") and v.Name:lower():find("coin", 1, true) then
      list[#list+1] = v
    end
  end
  coinCache = list
end

toggle(pAuto,"Auto Coins",false,function(s)
  autoCoin = s
  if s then coinRefresh = 0 end
end)

task.spawn(function()
  while true do
    task.wait(0.35)
    if autoCoin then
      local r = hrp()
      if r then
        if os.clock() - coinRefresh > 4 then
          coinRefresh = os.clock()
          collectCoins()
        end
        for _,v in ipairs(coinCache) do
          if v.Parent then
            if firetouchinterest then
              pcall(firetouchinterest, v, r, 0)
              pcall(firetouchinterest, v, r, 1)
            else
              pcall(function() r.CFrame = v.CFrame end)
              break
            end
          end
        end
      end
    end
  end
end)

